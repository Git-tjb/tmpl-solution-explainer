{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "before-model.schema.json",
  "title": "Before model",
  "description": "Structure of stages/01_discover/output/before-model.yaml: the user, what they were doing, what they did it with, and what hurt, before the solution existed. It holds no part of the solution. Rules that span records are in system-model.md (The before model) and enforced by scripts/check-model.mjs.",
  "type": "object",
  "required": [
    "schema_version",
    "user",
    "elements",
    "relationships"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "user": {
      "$ref": "#/$defs/id",
      "description": "The person element who is the user"
    },
    "elements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "measures": {
      "type": "array",
      "maxItems": 6,
      "description": "Measured costs of the old way, for the cost figure (system-model.md, The before model). Only from facts, never estimated.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/line",
            "description": "What was measured, at most six words"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "after": {
            "type": "object",
            "required": [
              "value",
              "sources"
            ],
            "additionalProperties": false,
            "description": "The value with the solution; shown only in why scenes",
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "sources": {
                "$ref": "#/$defs/sources"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^F[0-9]{3,}$"
      }
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/line",
          "description": "What it is, in plain words; for a pain, what hurt, at most 12 words"
        },
        "exact_name": {
          "$ref": "#/$defs/line",
          "description": "The real name of a means (a tool, a file), shown in parentheses"
        },
        "type": {
          "enum": [
            "person",
            "task",
            "means",
            "pain"
          ]
        },
        "hurts": {
          "$ref": "#/$defs/id",
          "description": "pain only: the element or relationship this pain is about"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "recurs": {
          "type": "object",
          "required": [
            "every",
            "sources"
          ],
          "additionalProperties": false,
          "description": "task only: the work recurs; the repeat figure draws it",
          "properties": {
            "every": {
              "$ref": "#/$defs/line",
              "description": "The period, at most four words (\"every week\")"
            },
            "shown": {
              "type": "integer",
              "minimum": 3,
              "maximum": 6,
              "default": 4,
              "description": "How many runs to draw"
            },
            "sources": {
              "$ref": "#/$defs/sources"
            }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "description": "means only: copies of it that diverged; the drift figure draws them",
          "items": {
            "type": "object",
            "required": [
              "label",
              "sources"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/line",
                "description": "At most four words"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              }
            }
          }
        },
        "queue": {
          "type": "object",
          "required": [
            "size",
            "label",
            "sources"
          ],
          "additionalProperties": false,
          "description": "person or task only: work waiting for it; the wait figure draws it",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12,
              "description": "How many waiting items to draw"
            },
            "label": {
              "$ref": "#/$defs/line",
              "description": "What waits, at most four words (\"requests\")"
            },
            "sources": {
              "$ref": "#/$defs/sources"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "pain"
              }
            }
          },
          "then": {
            "required": [
              "hurts"
            ],
            "not": {
              "required": [
                "exact_name"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "hurts"
              ]
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "verb",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "verb": {
          "$ref": "#/$defs/line"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        }
      }
    }
  }
}
