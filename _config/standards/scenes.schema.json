{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenes.schema.json",
  "title": "Storyboard scenes",
  "description": "Structure of stages/03_storyboard/output/scenes.json. Information-architecture rules are in _config/information-architecture.md and enforced by scripts/check-storyboard.mjs.",
  "type": "object",
  "required": ["schema_version", "core_message", "target_minutes", "budget", "views", "scenes", "map"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "core_message": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
    "target_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
    "budget": {
      "type": "array",
      "minItems": 1,
      "description": "Minutes and scenes per section, allocated before the scenes are written (narrative-arc.md, Budget)",
      "items": {
        "type": "object",
        "required": ["section", "scenes", "minutes"],
        "additionalProperties": false,
        "properties": {
          "section": { "$ref": "#/$defs/section" },
          "scenes": { "type": "integer", "minimum": 1 },
          "minutes": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "level", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "level": { "enum": ["before", "L1", "L2", "L3", "flow"] },
          "scope": { "$ref": "#/$defs/id", "description": "before: the word before; L1 and L2: the system; L3: a function; flow: a flow ID" },
          "figure": { "enum": ["map", "repeat", "drift", "scatter", "gap", "wait", "cost"], "default": "map", "description": "before views only: the problem figure, matched by the view spec (stages/03_storyboard/references/problem-figures.md)" },
          "mode": { "enum": ["wired", "structure"], "default": "wired", "description": "Matches the view spec's mode; structure views show what each part does, wired views show how they connect" }
        }
      }
    },
    "scenes": { "type": "array", "minItems": 8, "maxItems": 14, "items": { "$ref": "#/$defs/scene" } },
    "map": {
      "type": "object",
      "required": ["overview", "panels"],
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "description": "L1 and L2 view IDs" },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["element"],
            "additionalProperties": false,
            "properties": {
              "element": { "$ref": "#/$defs/id" },
              "view": { "$ref": "#/$defs/id", "description": "The element's L3 view, if it has one" },
              "detail": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[^/\\\\:][^:]*$" },
                "description": "Paths inside the source snapshot shown as L4 detail (folder tree or file)"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "section": { "enum": ["title", "problem", "answer", "why", "structure", "segmentation", "build", "in-use", "close"] },
    "facts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^F[0-9]{3,}$" } },
    "scene": {
      "type": "object",
      "required": ["id", "section", "title", "point", "mode", "level", "text", "reveals", "facts", "minutes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{2}$" },
        "section": { "$ref": "#/$defs/section" },
        "intent": { "enum": ["educate", "how-to", "persuade"], "description": "Set when the run has two intents" },
        "title": { "type": "string", "minLength": 1 },
        "point": { "type": "string", "minLength": 1, "description": "The single point this scene makes (the title scene: the purpose line)" },
        "mode": { "enum": ["explanation", "how-to"] },
        "level": { "enum": ["title", "before", "L1", "L2", "L3", "flow"], "description": "title: the title scene, which shows the title visual and no view" },
        "view": { "$ref": "#/$defs/id", "description": "A view ID from views[]. Absent on the title scene." },
        "adds": { "type": "string", "minLength": 1, "description": "Required when an earlier scene showed the same view: what this scene adds (a highlight, a reveal, a zoom)" },
        "about": { "enum": ["problem"], "description": "problem: the scene states a pain, so it shows a before view" },
        "highlight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elements": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "relationships": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "steps": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
          }
        },
        "text": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["line", "facts"],
            "additionalProperties": false,
            "properties": {
              "line": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
              "facts": { "$ref": "#/$defs/facts", "description": "The facts that carry this line" }
            }
          }
        },
        "reveals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "shows"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "shows": { "type": "string", "minLength": 1 }
            }
          }
        },
        "animation": {
          "type": "object",
          "required": ["explains"],
          "additionalProperties": false,
          "properties": { "explains": { "type": "string", "minLength": 1, "description": "The state change the animation explains" } }
        },
        "returns_to": { "type": "string", "pattern": "^S[0-9]{2}$", "description": "Close scenes: the answer scene whose message they return to" },
        "facts": { "$ref": "#/$defs/facts", "description": "The facts behind the scene's point" },
        "minutes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "section": { "const": "title" } }, "required": ["section"] }, "then": { "properties": { "level": { "const": "title" } }, "not": { "required": ["view"] } }, "else": { "required": ["view"], "properties": { "level": { "enum": ["before", "L1", "L2", "L3", "flow"] } } } }
      ]
    }
  }
}
