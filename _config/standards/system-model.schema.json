{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-model.schema.json",
  "title": "System model",
  "description": "Structure of stages/01_discover/output/system-model.yaml. Integrity rules that span records are in system-model.md and enforced by scripts/check-model.mjs.",
  "type": "object",
  "required": ["schema_version", "elements", "relationships"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "elements": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/element" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "line": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^F[0-9]{3,}$" }
    },
    "element": {
      "type": "object",
      "required": ["id", "name", "type", "responsibility", "why_separate", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/line", "description": "The functional name: what it does (\"Agent setup\")" },
        "exact_name": { "$ref": "#/$defs/line", "description": "The real name, shown in parentheses after name (\"aiso-ops\")" },
        "type": { "enum": ["actor", "system", "external", "function", "component", "store"] },
        "parent": { "$ref": "#/$defs/id" },
        "form": { "enum": ["file"], "description": "A store that is one file (a config or data file); drawn as a file, not a cylinder" },
        "responsibility": { "$ref": "#/$defs/line" },
        "why_separate": { "$ref": "#/$defs/line" },
        "sources": { "$ref": "#/$defs/sources" },
        "what_it_does": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["text", "sources"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/line", "description": "One line, at most 12 words" },
              "sources": { "$ref": "#/$defs/sources" }
            }
          }
        },
        "tech": { "$ref": "#/$defs/line" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["function", "component", "store"] } } },
          "then": { "required": ["parent"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["actor", "system", "external"] } } },
          "then": { "not": { "required": ["parent"] } }
        },
        {
          "if": { "properties": { "type": { "not": { "const": "store" } } } },
          "then": { "not": { "required": ["form"] } }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "required": ["id", "from", "to", "verb", "kind", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "verb": { "$ref": "#/$defs/line" },
        "kind": { "enum": ["control", "data", "human"] },
        "sources": { "$ref": "#/$defs/sources" }
      }
    }
  }
}
